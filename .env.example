# Compose serves HTTP on 127.0.0.1:18080. Public HTTPS needs a separate reverse proxy.
# Replace the placeholders before starting the app.
APP_DOMAIN=localhost
POSTGRES_DB=topsbottg
POSTGRES_USER=topsbottg_app
POSTGRES_PASSWORD=CHANGE_ME_LONG_RANDOM_PASSWORD
DATABASE_URL=postgresql+asyncpg://topsbottg_app:CHANGE_ME_LONG_RANDOM_PASSWORD@postgres:5432/topsbottg
BOT_TOKEN=CHANGE_ME_TELEGRAM_BOT_TOKEN
# MTProto credentials from https://my.telegram.org (not the bot token).
# Both are required to search people by @username; Telegram ID search works without them.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
ADMIN_TELEGRAM_IDS=CHANGE_ME_NUMERIC_TELEGRAM_IDS
MINI_APP_URL=https://localhost/miniapp/
BROADCAST_RATE_PER_SECOND=5
MINI_APP_INIT_DATA_MAX_AGE_SECONDS=86400
LOG_LEVEL=INFO

# Only used by legacy certificate scripts; not required for Docker Compose.
LETSENCRYPT_EMAIL=admin@example.com
